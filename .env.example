# --- AI provider (optional) -------------------------------------------------
# Leave everything unset to use the built-in offline "Aria" engine.
# Set a key (and optionally a base URL) to route requests to a live model.
# Any OpenAI-compatible /chat/completions endpoint works.
#
# OPENAI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- Storage (optional) -----------------------------------------------------
# Where the SQLite database lives. Defaults to <project>/.data/app.db
# DATABASE_PATH=/absolute/path/to/app.db
# DATA_DIR=/absolute/path/to/data
